# =============================================================================
# LabDDB CU Cover Page + UprintBD Platform Environment Configuration
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Cloudflare Workers production, set secrets via wrangler:
#   npx wrangler secret put UPRINT_EMAIL
#   npx wrangler secret put UPRINT_PASSWORD
#   npx wrangler secret put FIREBASE_API_KEY
#   npx wrangler secret put LABDDB_DATABASE_URL
#   npx wrangler secret put LABDDB_SERVICE_ACCOUNT
#   npx wrangler secret put LDDB_DEMO_SERVICE_ACCOUNT
# =============================================================================

# --- Server Port (Node.js local runtime) ---
PORT=3000

# --- Allowed CORS Origin (Defaults to * if unset) ---
ALLOWED_ORIGIN=*

# --- Project Administrator Email ---
# Matches identity token email for full admin privileges (INV-14)
ADMIN_EMAIL=htmlwithkhalid@gmail.com

# --- UprintBD Kiosk Bridge Credentials ---
# Institutional account for automating kiosk OTP generation
UPRINT_EMAIL=institutional_account@cu.ac.bd
UPRINT_PASSWORD=your_uprintbd_password_here
UPRINT_BASE_URL=https://uprintbd.com

# --- Firebase Identity Toolkit (Client Auth Verification) ---
# Web API Key from Firebase Console -> Project Settings -> General
FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
LABDDB_PROJECT_ID=labddb-pro

# --- LabDDB-Pro Database (Financial Ledger & User Store) ---
LABDDB_DATABASE_URL=https://labddb-pro-default-rtdb.asia-southeast1.firebasedatabase.app

# Service Account JSON (minified single line string or base64)
# Required permissions: Firebase Realtime Database Admin
LABDDB_SERVICE_ACCOUNT={"type":"service_account","project_id":"labddb-pro","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@labddb-pro.iam.gserviceaccount.com","client_id":"..."}

# --- lddb-demo Service Account (Course Catalogue) ---
# Used for minting scoped custom tokens for course catalogue administration
LDDB_DEMO_SERVICE_ACCOUNT={"type":"service_account","project_id":"lddb-demo","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@lddb-demo.iam.gserviceaccount.com","client_id":"..."}

# Optional: Allow public/demo edits to course catalogue without auth
ALLOW_PUBLIC_CATALOGUE_EDIT=false
